{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "erasableSyntaxOnly": true,
    "module": "node20",
    "outDir": "dist",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/data/*.json"]
}
