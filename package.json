{
  "name": "mpls-landlord-api",
  "private": true,
  "license": "ISC",
  "author": "Kanad Gupta",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "knip && oxlint --deny-warnings && prettier --check . && tsc --noEmit",
    "fetch": "node --env-file .env src/bin/fetchAndProcessData.ts",
    "pretest": "npm run check",
    "start": "node --watch --env-file-if-exists .env src/serve.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "d3-dsv": "^3.0.1",
    "hono": "^4.12.2"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.3.0",
    "knip": "^5.87.0",
    "nock": "^14.0.11",
    "oxlint": "^1.56.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm"
    }
  }
}
